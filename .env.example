# ============================================
# Docker Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================
# REQUIRED Configuration
# ============================================

# Google Gemini API Key (REQUIRED - get from https://aistudio.google.com/)
# ⚠️ MUST BE SET or application will not start
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# Server Configuration
# ============================================

# Node environment (production or development)
# Use "production" for hosted versions
NODE_ENV=production

# Backend server port inside Docker container
# Usually 3001, change only if port conflict
PORT=3001

# Frontend URL for CORS - CRITICAL FOR HOSTED VERSION ⚠️
# This MUST match your actual domain in production
# Examples:
#   Local development:    http://localhost
#   Hosted development:   https://staging.yourdomain.com
#   Production:           https://yourdomain.com
#
# Used by backend to allow requests from your frontend
FRONTEND_URL=http://localhost

# ============================================
# Rate Limiting
# ============================================

# Rate limit window in milliseconds
# 900000ms = 15 minutes (default)
# Adjust based on your traffic needs
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window per IP address
# Default: 100 requests per 15 minutes
# Recommendations:
#   - Low usage:     100 (5-10 requests/min)
#   - Medium usage:  200 (13-20 requests/min)
#   - High usage:    300 (20 requests/min)
#
# AI endpoints have separate limit of 30 requests per 15 min
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# Background Jobs (Optional)
# ============================================

# Enable/disable prospect collection background job
# true = enabled, false = disabled
PROSPECT_COLLECTION_ENABLED=true

# Cron schedule for prospect collection
# Format: minute hour day month dayOfWeek (5 fields)
# Examples:
#   0 * * * *     = Every hour at minute 0
#   0 0 * * *     = Daily at midnight
#   0 */4 * * *   = Every 4 hours
#   0 9-17 * * *  = Every hour between 9 AM and 5 PM
PROSPECT_COLLECTION_CRON=0 * * * *

# ============================================
# Mixpanel Integration (Raw Event Export API)
# ============================================

# Choose ONE authentication method:

# Method 1: Project Secret (Recommended for simplicity)
# Get these from Mixpanel Project Settings
MIXPANEL_PROJECT_ID=
MIXPANEL_PROJECT_SECRET=

# Method 2: Service Account (More secure, but more setup)
# Create Service Account in Organization Settings
# MIXPANEL_SERVICE_ACCOUNT_USERNAME=
# MIXPANEL_SERVICE_ACCOUNT_SECRET=

# Enable automatic sync (default: false)
MIXPANEL_SYNC_ENABLED=true

# Cron schedule for Mixpanel sync (default: every hour)
# Format: minute hour day month dayOfWeek (5 fields)
# Examples:
#   0 * * * *     = Every hour at minute 0
#   0 */4 * * *   = Every 4 hours
#   0 0 * * *     = Daily at midnight
MIXPANEL_SYNC_CRON=0 * * * *

# ============================================
# IMPORTANT NOTES FOR HOSTED DEPLOYMENT
# ============================================
#
# 1. FRONTEND_URL:
#    ⚠️ This is CRITICAL! Update to your actual domain
#    Wrong: http://localhost
#    Correct: https://yourdomain.com
#
#    Without the correct FRONTEND_URL, CORS errors will block your frontend
#    from calling the API
#
# 2. GEMINI_API_KEY:
#    ⚠️ Never expose in public repositories
#    Use Dokploy/Coolify's environment variable UI
#    Get key from: https://aistudio.google.com/app/apikey
#
# 3. NODE_ENV:
#    Always set to "production" for hosted versions
#    Enables optimizations and security features
#
# 4. RATE_LIMIT_MAX_REQUESTS:
#    100 requests per 15 min might be too low for real users
#    Start with 200-300 for hosted version
#    Adjust based on actual usage patterns
#
# 5. Never commit .env to git:
#    Add to .gitignore (already done)
#    Use platform's secret management
#
# ============================================
# Deployment Platforms
# ============================================
#
# Dokploy:
#   1. Go to Project Settings → Environment Variables
#   2. Add each variable from this file
#   3. Set actual values (not placeholders)
#   4. Deploy/restart service
#
# Coolify:
#   1. Go to Service Settings → Environment
#   2. Add each variable with actual values
#   3. Click Deploy or Redeploy
#
# ============================================
