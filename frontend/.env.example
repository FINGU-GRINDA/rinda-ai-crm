# =============================================================================
# Rinda CRM - Frontend Environment Variables
# =============================================================================
# Legend:
#   [REQUIRED] = App will not function in production without it
#   [OPTIONAL] = Has a working default; override only if needed
# =============================================================================

# -----------------------------------------------------------------------------
# Build-time variables (consumed by Vite, baked into bundle)
# -----------------------------------------------------------------------------
# Base URL of the Elysia backend API.
# - In development the Vite dev server proxies /api to this URL.
# - In production this is read by services in src/ and bundled into the JS.
# - When using the Docker image (nginx reverse-proxy), set this to "" so the
#   bundle uses relative /api paths that nginx forwards to BACKEND_URL.
VITE_API_URL=http://localhost:3001   # [OPTIONAL] default: http://localhost:3001

# -----------------------------------------------------------------------------
# Runtime variables (consumed by the nginx container at startup)
# -----------------------------------------------------------------------------
# Upstream backend that nginx proxies /api requests to.
# Only used inside the Docker image (substituted into nginx.conf.template
# by docker-entrypoint.sh at container start).
BACKEND_URL=http://elysia-server:3001   # [REQUIRED for Docker deploy]
