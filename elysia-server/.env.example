# =============================================================================
# Rinda CRM - Elysia Server Environment Variables
# =============================================================================
# Legend:
#   [REQUIRED] = Server fails to start or core functionality breaks without it
#   [OPTIONAL] = Feature-gated; integration is skipped/disabled if missing
# =============================================================================

# -----------------------------------------------------------------------------
# Database  [REQUIRED]
# -----------------------------------------------------------------------------
# Single source of truth. Used by the app (pg pool), drizzle-kit migrations,
# and the in-app migration runner (src/db/bootstrap.ts).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

DB_POOL_MIN=2                     # [OPTIONAL] default: 2
DB_POOL_MAX=10                    # [OPTIONAL] default: 10

# -----------------------------------------------------------------------------
# Server  [REQUIRED]
# -----------------------------------------------------------------------------
PORT=3001                         # [OPTIONAL] default: 3001
NODE_ENV=production               # [OPTIONAL] default: development
LOGGING_LEVEL=info                # [OPTIONAL] default: info (prod) / debug (dev)

# Comma-separated list of allowed frontend origins (CORS).
# The first URL is used for OAuth redirects.
FRONTEND_URLS=http://localhost:3000,https://app.example.com   # [REQUIRED]

# -----------------------------------------------------------------------------
# Authentication  [REQUIRED]
# -----------------------------------------------------------------------------
# JWT signing keys. Use long, random strings (32+ chars).
JWT_SECRET=                       # [REQUIRED] auth tokens fail without this
JWT_REFRESH_SECRET=               # [REQUIRED] refresh tokens fail without this

# Symmetric key used by EncryptionService (AES-256-GCM) to encrypt
# stored OAuth tokens and other secrets at rest. The service is eagerly
# instantiated at startup — the server will THROW on boot if missing.
ENCRYPTION_KEY=                   # [REQUIRED]

# -----------------------------------------------------------------------------
# Gemini AI  [OPTIONAL]
# -----------------------------------------------------------------------------
# Without this, AI-powered features (summaries, extraction, etc.) are disabled.
GEMINI_API_KEY=                   # [OPTIONAL]

# -----------------------------------------------------------------------------
# Slack Integration  [OPTIONAL]
# -----------------------------------------------------------------------------
# Without these, Slack event handling and message ingestion are disabled.
SLACK_SIGNING_SECRET=             # [OPTIONAL] required only if Slack is enabled
SLACK_BOT_TOKEN=                  # [OPTIONAL] required only if Slack is enabled

# Channel IDs route incoming Slack events. Only the configured channels
# will be processed.
CS_CHANNEL_ID=                    # [OPTIONAL]
SALES_CHANNEL_ID=                 # [OPTIONAL]
MEETING_NOTES_CHANNEL_ID=         # [OPTIONAL]

# Slack user ID for the OpenClaw bot (e.g. U0123ABCD).
OPENCLAW_BOT_USER_ID=             # [OPTIONAL]

# -----------------------------------------------------------------------------
# Google OAuth (Gmail + Calendar)  [OPTIONAL]
# -----------------------------------------------------------------------------
# Without these, Gmail and Calendar integrations are disabled.
GOOGLE_CLIENT_ID=                 # [OPTIONAL]
GOOGLE_CLIENT_SECRET=             # [OPTIONAL]
GOOGLE_REDIRECT_URI=http://localhost:3001/api/gmail/oauth/callback   # [OPTIONAL]

# -----------------------------------------------------------------------------
# Mixpanel Analytics  [OPTIONAL]
# -----------------------------------------------------------------------------
# Without these, analytics endpoints report as unconfigured.
MIXPANEL_PROJECT_ID=              # [OPTIONAL]
MIXPANEL_PROJECT_SECRET=          # [OPTIONAL]
