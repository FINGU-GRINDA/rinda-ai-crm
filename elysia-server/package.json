{
  "name": "rinda-crm-backend-ts",
  "version": "2.0.0",
  "description": "RINDA CRM Backend - TypeScript/Elysia/PostgreSQL",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "db:reset": "bash ./scripts/db-reset.sh",
    "docker:db-up": "docker compose -f compose.db.yml up -d",
    "docker:db-down": "docker compose -f compose.db.yml down",
    "docker:db-logs": "docker compose -f compose.db.yml logs -f postgres",
    "docker:db-clean": "docker compose -f compose.db.yml down -v",
    "type-check": "tsc --noEmit",
    "lint": "biome check --write ./src",
    "lint:check": "biome check ./src",
    "format": "biome format --write ./src",
    "format:check": "biome format ./src"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.1.0",
    "@elysiajs/swagger": "^1.1.0",
    "@google/generative-ai": "^0.21.0",
    "@node-rs/argon2": "^2.0.2",
    "@slack/web-api": "^7.8.0",
    "@types/jsonwebtoken": "^9.0.10",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.2.0",
    "googleapis": "^144.0.0",
    "jsonwebtoken": "^9.0.3",
    "officeparser": "^6.0.4",
    "pg": "8.16.3",
    "pino": "^10.0.0",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.5",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@elysiajs/eden": "^1.4.4",
    "@types/domhandler": "^3.1.0",
    "@types/marked": "^6.0.0",
    "bun-types": "^1.3.1",
    "drizzle-kit": "^0.30.0",
    "typescript": "^5.7.0",
    "@types/pg": "^8.15.5"
  }
}
